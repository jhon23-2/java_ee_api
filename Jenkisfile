pipeline {
    agent any 
    stages {
     stage ("maven clean"){
    agent { 
        docker {
            image 'maven:3.9-eclipse-temurin-17'
        }
    }

      steps {
        sh 'mvn clean install'
      }
     }
    }

post {
  success {
    echo 'Docker was initialized and mvn clean install was executed successfully!'
  }

failure {
  echo 'Something was wrong!'
}
}
}
